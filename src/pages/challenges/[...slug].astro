---
import { getCollection, render } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import Container from "../../components/Container.astro";
import { formatDate } from "../../lib/utils";

export async function getStaticPaths() {
  const items = await getCollection(
    "challenges",
    ({ data }) => import.meta.env.DEV || !data.draft,
  );
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<PageLayout title={item.data.title} description={item.data.description}>
  <section class="pt-32 pb-16">
    <Container size="md">
      <article class="prose dark:prose-invert max-w-none">
        <header class="mb-8 not-prose space-y-2">
          <h1 class="text-3xl font-bold tracking-tight text-black dark:text-white">
            {item.data.title}
          </h1>
          <p class="text-sm text-black/50 dark:text-white/50">
            <time>{formatDate(item.data.date)}</time>
            {item.data.source && <> · @{item.data.source}</>}
          </p>
          {(item.data.liveUrl || item.data.repoUrl) && (
            <p class="text-sm flex flex-wrap gap-3">
              {item.data.liveUrl && (
                <a
                  href={item.data.liveUrl}
                  target="_blank"
                  rel="noopener"
                  class="underline decoration-[.5px] underline-offset-2 hover:text-black dark:hover:text-white blend"
                >
                  Live →
                </a>
              )}
              {item.data.repoUrl && (
                <a
                  href={item.data.repoUrl}
                  target="_blank"
                  rel="noopener"
                  class="underline decoration-[.5px] underline-offset-2 hover:text-black dark:hover:text-white blend"
                >
                  Source
                </a>
              )}
            </p>
          )}
        </header>
        <Content />
      </article>
    </Container>
  </section>
</PageLayout>
