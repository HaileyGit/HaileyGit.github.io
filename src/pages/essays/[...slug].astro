---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('essays', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={`${post.data.title} · Hailey`} description={post.data.excerpt}>
  <article class="mx-auto max-w-2xl">
    <header class="mb-12">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
        {post.data.title}
      </h1>
    </header>
    <div class="prose prose-neutral dark:prose-invert prose-lg max-w-none prose-headings:tracking-tight prose-p:leading-loose prose-p:my-6 prose-a:text-blue-600 prose-a:no-underline hover:prose-a:underline">
      <Content />
    </div>
  </article>
</BaseLayout>
