---
import { getCollection, render } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import Container from "../../components/Container.astro";
import { formatDate } from "../../lib/utils";

export async function getStaticPaths() {
  const posts = await getCollection("essays", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<PageLayout title={post.data.title} description={post.data.excerpt}>
  <section class="pt-32 pb-16">
    <Container size="md">
      <article class="prose dark:prose-invert max-w-none">
        <header class="mb-12 not-prose">
          <time class="block text-sm text-black/50 dark:text-white/50">
            {formatDate(post.data.date)}
          </time>
          <h1 class="mt-3 text-3xl font-bold tracking-tight text-black dark:text-white sm:text-4xl">
            {post.data.title}
          </h1>
        </header>
        <Content />
      </article>
    </Container>
  </section>
</PageLayout>
