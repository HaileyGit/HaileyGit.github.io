---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Hailey">
  <section class="space-y-6">
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
      Hailey<span class="text-neutral-400">.</span>
    </h1>
  </section>

  <section class="mt-16 grid gap-4 sm:grid-cols-2">
    <a
      href="/challenges"
      class="group rounded-lg border border-neutral-200 p-6 transition hover:border-neutral-400 dark:border-neutral-800 dark:hover:border-neutral-600"
    >
      <h2 class="font-semibold">Challenges</h2>
    </a>
    <a
      href="/projects"
      class="group rounded-lg border border-neutral-200 p-6 transition hover:border-neutral-400 dark:border-neutral-800 dark:hover:border-neutral-600"
    >
      <h2 class="font-semibold">Projects</h2>
    </a>
    <a
      href="/work"
      class="group rounded-lg border border-neutral-200 p-6 transition hover:border-neutral-400 dark:border-neutral-800 dark:hover:border-neutral-600"
    >
      <h2 class="font-semibold">Work</h2>
    </a>
    <a
      href="/blog"
      class="group rounded-lg border border-neutral-200 p-6 transition hover:border-neutral-400 dark:border-neutral-800 dark:hover:border-neutral-600"
    >
      <h2 class="font-semibold">Blog</h2>
    </a>
  </section>
</BaseLayout>
