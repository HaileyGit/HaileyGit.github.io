---
import { getCollection, render } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import Container from "../../components/Container.astro";

export async function getStaticPaths() {
  const items = await getCollection("work", ({ data }) => !data.draft);
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<PageLayout title={item.data.title} description={item.data.description}>
  <section class="pt-32 pb-16">
    <Container size="md">
      <article class="prose dark:prose-invert max-w-none">
        <header class="mb-8 not-prose space-y-3">
          <h1 class="text-3xl font-bold tracking-tight text-black dark:text-white">
            {item.data.title}
          </h1>
          <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm text-black/60 dark:text-white/60">
            {item.data.role && (
              <>
                <dt>Role</dt>
                <dd>{item.data.role}</dd>
              </>
            )}
            {item.data.period && (
              <>
                <dt>Period</dt>
                <dd>{item.data.period}</dd>
              </>
            )}
            {item.data.stack && (
              <>
                <dt>Stack</dt>
                <dd>{item.data.stack.join(", ")}</dd>
              </>
            )}
          </dl>
        </header>
        <Content />
      </article>
    </Container>
  </section>
</PageLayout>
