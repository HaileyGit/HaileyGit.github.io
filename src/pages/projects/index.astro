---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const items = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Projects · Hailey" description="개인 사이드 프로젝트">
  <header class="space-y-2">
    <h1 class="text-3xl font-bold tracking-tight">Projects</h1>
    <p class="text-neutral-600 dark:text-neutral-400">사이드 프로젝트와 출시한 작업.</p>
  </header>

  {items.length === 0 ? (
    <p class="mt-12 text-sm text-neutral-500">아직 등록된 프로젝트가 없습니다.</p>
  ) : (
    <ul class="mt-12 space-y-8">
      {items.map((item) => (
        <li>
          <a href={`/projects/${item.id}`} class="group block">
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="font-semibold transition group-hover:text-blue-600">{item.data.title}</h2>
              <time class="shrink-0 text-sm text-neutral-500">
                {item.data.date.toISOString().slice(0, 10)}
              </time>
            </div>
            {item.data.description && (
              <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
                {item.data.description}
              </p>
            )}
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
