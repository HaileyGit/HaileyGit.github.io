---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Blog · Hailey" description="학습 노트와 잡문">
  <header class="space-y-2">
    <h1 class="text-3xl font-bold tracking-tight">Blog</h1>
    <p class="text-neutral-600 dark:text-neutral-400">학습 노트와 잡문.</p>
  </header>

  {posts.length === 0 ? (
    <p class="mt-12 text-sm text-neutral-500">아직 작성된 글이 없습니다.</p>
  ) : (
    <ul class="mt-12 space-y-8">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}`} class="group block">
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="font-semibold transition group-hover:text-blue-600">{post.data.title}</h2>
              <time class="shrink-0 text-sm text-neutral-500">
                {post.data.date.toISOString().slice(0, 10)}
              </time>
            </div>
            {post.data.description && (
              <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
                {post.data.description}
              </p>
            )}
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
