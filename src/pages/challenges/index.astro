---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const items = (await getCollection('challenges', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Challenges · Hailey">
  <header class="space-y-2">
    <h1 class="text-3xl font-bold tracking-tight">Challenges</h1>
  </header>

  {items.length === 0 ? (
    <p class="mt-12 text-sm text-neutral-500">아직 등록된 챌린지가 없습니다.</p>
  ) : (
    <ul class="mt-12 space-y-8">
      {items.map((item) => (
        <li>
          <a href={`/challenges/${item.id}`} class="group block">
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="font-semibold transition group-hover:text-blue-600">{item.data.title}</h2>
              <time class="shrink-0 text-sm text-neutral-500">
                {item.data.date.toISOString().slice(0, 10)}
              </time>
            </div>
            {item.data.description && (
              <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
                {item.data.description}
              </p>
            )}
            {item.data.source && (
              <span class="mt-2 inline-block rounded bg-neutral-100 px-2 py-0.5 text-xs text-neutral-600 dark:bg-neutral-800 dark:text-neutral-400">
                @{item.data.source}
              </span>
            )}
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
