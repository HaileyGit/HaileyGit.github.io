---
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout title="">
  <section class="relative h-[60vh] w-full">
    <div class="animate absolute h-full w-full flex items-center justify-center">
      <div class="relative w-full h-full flex items-center justify-center">
        <div class="p-5 text-center">
          <p class="animated text-3xl md:text-5xl font-bold text-black dark:text-white tracking-tight">
            Hailey<span class="text-black/40 dark:text-white/40">.</span>
          </p>
          <a
            href="/projects"
            class="mt-8 inline-flex items-center gap-1 text-sm underline decoration-[.5px] decoration-black/25 dark:decoration-white/50 hover:decoration-black dark:hover:decoration-white text-black/75 dark:text-white/75 hover:text-black dark:hover:text-white underline-offset-2 blend"
          >
            프로젝트 보기 →
          </a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    function initAnimateOnScroll() {
      const els = document.querySelectorAll(".animate");
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("show");
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.1 });
      els.forEach((el) => io.observe(el));
    }
    document.addEventListener("astro:after-swap", initAnimateOnScroll);
    initAnimateOnScroll();
  </script>
</PageLayout>
